nes": [{"type": "context", "content": "from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker, AsyncSession"}, {"type": "context", "content": "from dotenv import load_dotenv"}, {"type": "context", "content": ""}, {"type": "removed", "content": "load_dotenv('.env_6fb25fff-dbb0-4770-a1c9-7ca2debd1b59', override=True)"}, {"type": "added", "content": "load_dotenv('.env_b053751c0f39d3e4', override=True)"}, {"type": "context", "content": ""}, {"type": "context", "content": "from app.main import app"}, {"type": "context", "content": "from app.database import Base, get_db"}]}]}, {"path": "tests/run_all.sh", "additions": 33, "deletions": 0, "hunks": [{"header": "@@ -0,0 +1,33 @@", "lines": [{"type": "added", "content": "#!/bin/bash"}, {"type": "added", "content": "# Runs all test_*.sh scripts in this directory and reports a summary."}, {"type": "added", "content": "set -u"}, {"type": "added", "content": "SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\""}, {"type": "added", "content": "export BASE_URL=${BASE_URL:-http://localhost:23516}"}, {"type": "added", "content": ""}, {"type": "added", "content": "PASS_COUNT=0"}, {"type": "added", "content": "FAIL_COUNT=0"}, {"type": "added", "content": "FAILED_SCRIPTS=()"}, {"type": "added", "content": ""}, {"type": "added", "content": "for script in \"$SCRIPT_DIR\"/test_*.sh; do"}, {"type": "added", "content": "  [ -e \"$script\" ] || continue"}, {"type": "added", "content": "  echo \"==== Running $(basename \"$script\") ====\""}, {"type": "added", "content": "  OUTPUT=$(bash \"$script\")"}, {"type": "added", "content": "  RC=$?"}, {"type": "added", "content": "  echo \"$OUTPUT\""}, {"type": "added", "content": "  if [ $RC -eq 0 ] && echo \"$OUTPUT\" | tail -n1 | grep -q \"^PASSED$\"; then"}, {"type": "added", "content": "    PASS_COUNT=$((PASS_COUNT + 1))"}, {"type": "added", "content": "  else"}, {"type": "added", "content": "    FAIL_COUNT=$((FAIL_COUNT + 1))"}, {"type": "added", "content": "    FAILED_SCRIPTS+=(\"$(basename \"$script\")\")"}, {"type": "added", "content": "  fi"}, {"type": "added", "content": "  echo \"\""}, {"type": "added", "content": "done"}, {"type": "added", "content": ""}, {"type": "added", "content": "echo \"==== Summary ====\""}, {"type": "added", "content": "echo \"PASSED: $PASS_COUNT\""}, {"type": "added", "content": "echo \"FAILED: $FAIL_COUNT\""}, {"type": "added", "content": "if [ $FAIL_COUNT -gt 0 ]; then"}, {"type": "added", "content": "  echo \"Failed scripts: ${FAILED_SCRIPTS[*]}\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": "exit 0"}]}]}, {"path": "tests/test_api_keys.sh", "additions": 61, "deletions": 0, "hunks": [{"header": "@@ -0,0 +1,61 @@", "lines": [{"type": "added", "content": "#!/bin/bash"}, {"type": "added", "content": "# Tests for /api/v1/api-keys endpoints (admin-key protected)"}, {"type": "added", "content": "set -u"}, {"type": "added", "content": "BASE_URL=${BASE_URL:-http://localhost:23516}"}, {"type": "added", "content": "SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\""}, {"type": "added", "content": "REPO_DIR=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\""}, {"type": "added", "content": ""}, {"type": "added", "content": "if [ -f \"$REPO_DIR/.env_b053751c0f39d3e4\" ]; then"}, {"type": "added", "content": "  export $(grep -E '^ADMIN_API_KEY=' \"$REPO_DIR/.env_b053751c0f39d3e4\" | xargs)"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "if [ -z \"${ADMIN_API_KEY:-}\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:ADMIN_API_KEY not set\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 1. No admin header -> 401"}, {"type": "added", "content": "NO_AUTH_CODE=$(curl -s -o /dev/null -w \"%{http_code}\" -X POST \"$BASE_URL/api/v1/api-keys/\" \\"}, {"type": "added", "content": "  -H \"Content-Type: application/json\" -d '{\"name\":\"no-auth-key\"}')"}, {"type": "added", "content": "if [ \"$NO_AUTH_CODE\" != \"401\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:expected 401 without admin header, got $NO_AUTH_CODE\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 2. Create API key"}, {"type": "added", "content": "CREATE_RESP=$(curl -s -X POST \"$BASE_URL/api/v1/api-keys/\" \\"}, {"type": "added", "content": "  -H \"Content-Type: application/json\" \\"}, {"type": "added", "content": "  -H \"X-Admin-Key: $ADMIN_API_KEY\" \\"}, {"type": "added", "content": "  -d '{\"name\":\"test-suite-key\"}')"}, {"type": "added", "content": ""}, {"type": "added", "content": "KEY_ID=$(echo \"$CREATE_RESP\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('id',''))\")"}, {"type": "added", "content": "RAW_KEY=$(echo \"$CREATE_RESP\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('api_key',''))\")"}, {"type": "added", "content": ""}, {"type": "added", "content": "if [ -z \"$KEY_ID\" ] || [ -z \"$RAW_KEY\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:could not create api key: $CREATE_RESP\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 3. List API keys"}, {"type": "added", "content": "LIST_CODE=$(curl -s -o /tmp/api_keys_list.json -w \"%{http_code}\" \"$BASE_URL/api/v1/api-keys/\" \\"}, {"type": "added", "content": "  -H \"X-Admin-Key: $ADMIN_API_KEY\")"}, {"type": "added", "content": "if [ \"$LIST_CODE\" != \"200\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:list api keys expected 200, got $LIST_CODE\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": "FOUND=$(python3 -c \"import json; data=json.load(open('/tmp/api_keys_list.json')); print(any(k['id']=='$KEY_ID' for k in data))\")"}, {"type": "added", "content": "if [ \"$FOUND\" != \"True\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:created key not found in list\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 4. Revoke API key"}, {"type": "added", "content": "REVOKE_CODE=$(curl -s -o /dev/null -w \"%{http_code}\" -X DELETE \"$BASE_URL/api/v1/api-keys/$KEY_ID\" \\"}, {"type": "added", "content": "  -H \"X-Admin-Key: $ADMIN_API_KEY\")"}, {"type": "added", "content": "if [ \"$REVOKE_CODE\" != \"200\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:revoke api key expected 200, got $REVOKE_CODE\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "echo \"PASSED\""}, {"type": "added", "content": "exit 0"}]}]}, {"path": "tests/test_tasks.sh", "additions": 117, "deletions": 0, "hunks": [{"header": "@@ -0,0 +1,117 @@", "lines": [{"type": "added", "content": "#!/bin/bash"}, {"type": "added", "content": "# Tests for /api/v1/tasks endpoints (X-API-Key protected), including bulk delete-all"}, {"type": "added", "content": "set -u"}, {"type": "added", "content": "BASE_URL=${BASE_URL:-http://localhost:23516}"}, {"type": "added", "content": "SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\""}, {"type": "added", "content": "REPO_DIR=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\""}, {"type": "added", "content": ""}, {"type": "added", "content": "if [ -f \"$REPO_DIR/.env_b053751c0f39d3e4\" ]; then"}, {"type": "added", "content": "  export $(grep -E '^ADMIN_API_KEY=' \"$REPO_DIR/.env_b053751c0f39d3e4\" | xargs)"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "if [ -z \"${ADMIN_API_KEY:-}\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:ADMIN_API_KEY not set\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "CREATED_KEY_IDS=()"}, {"type": "added", "content": ""}, {"type": "added", "content": "cleanup() {"}, {"type": "added", "content": "  for kid in \"${CREATED_KEY_IDS[@]:-}\"; do"}, {"type": "added", "content": "    [ -n \"$kid\" ] && curl -s -o /dev/null -X DELETE \"$BASE_URL/api/v1/api-keys/$kid\" -H \"X-Admin-Key: $ADMIN_API_KEY\""}, {"type": "added", "content": "  done"}, {"type": "added", "content": "}"}, {"type": "added", "content": "trap cleanup EXIT"}, {"type": "added", "content": ""}, {"type": "added", "content": "# Create an API key to use for task CRUD"}, {"type": "added", "content": "CREATE_KEY_RESP=$(curl -s -X POST \"$BASE_URL/api/v1/api-keys/\" \\"}, {"type": "added", "content": "  -H \"Content-Type: application/json\" \\"}, {"type": "added", "content": "  -H \"X-Admin-Key: $ADMIN_API_KEY\" \\"}, {"type": "added", "content": "  -d '{\"name\":\"tasks-test-key\"}')"}, {"type": "added", "content": "API_KEY_ID=$(echo \"$CREATE_KEY_RESP\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('id',''))\")"}, {"type": "added", "content": "API_KEY=$(echo \"$CREATE_KEY_RESP\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('api_key',''))\")"}, {"type": "added", "content": "CREATED_KEY_IDS+=(\"$API_KEY_ID\")"}, {"type": "added", "content": ""}, {"type": "added", "content": "if [ -z \"$API_KEY\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:could not create api key for tasks test: $CREATE_KEY_RESP\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 0. No API key -> 401"}, {"type": "added", "content": "NO_KEY_CODE=$(curl -s -o /dev/null -w \"%{http_code}\" \"$BASE_URL/api/v1/tasks\")"}, {"type": "added", "content": "if [ \"$NO_KEY_CODE\" != \"401\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:expected 401 without X-API-Key, got $NO_KEY_CODE\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 1. POST - create task"}, {"type": "added", "content": "CREATE_RESP=$(curl -s -X POST \"$BASE_URL/api/v1/tasks\" \\"}, {"type": "added", "content": "  -H \"Content-Type: application/json\" \\"}, {"type": "added", "content": "  -H \"X-API-Key: $API_KEY\" \\"}, {"type": "added", "content": "  -d '{\"title\":\"Test Task\",\"description\":\"desc\",\"status\":\"TODO\",\"priority\":\"LOW\"}')"}, {"type": "added", "content": "TASK_ID=$(echo \"$CREATE_RESP\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('id',''))\")"}, {"type": "added", "content": "if [ -z \"$TASK_ID\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:could not create task: $CREATE_RESP\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 2. GET single task"}, {"type": "added", "content": "GET_CODE=$(curl -s -o /dev/null -w \"%{http_code}\" \"$BASE_URL/api/v1/tasks/$TASK_ID\" -H \"X-API-Key: $API_KEY\")"}, {"type": "added", "content": "if [ \"$GET_CODE\" != \"200\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:get task expected 200, got $GET_CODE\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 3. GET list"}, {"type": "added", "content": "LIST_CODE=$(curl -s -o /dev/null -w \"%{http_code}\" \"$BASE_URL/api/v1/tasks?limit=20&offset=0\" -H \"X-API-Key: $API_KEY\")"}, {"type": "added", "content": "if [ \"$LIST_CODE\" != \"200\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:list tasks expected 200, got $LIST_CODE\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 4. PUT - update task"}, {"type": "added", "content": "UPDATE_CODE=$(curl -s -o /dev/null -w \"%{http_code}\" -X PUT \"$BASE_URL/api/v1/tasks/$TASK_ID\" \\"}, {"type": "added", "content": "  -H \"Content-Type: application/json\" \\"}, {"type": "added", "content": "  -H \"X-API-Key: $API_KEY\" \\"}, {"type": "added", "content": "  -d '{\"status\":\"IN_PROGRESS\"}')"}, {"type": "added", "content": "if [ \"$UPDATE_CODE\" != \"200\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:update task expected 200, got $UPDATE_CODE\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 5. Create a second task, then DELETE ALL (remove all api feature)"}, {"type": "added", "content": "curl -s -X POST \"$BASE_URL/api/v1/tasks\" \\"}, {"type": "added", "content": "  -H \"Content-Type: application/json\" \\"}, {"type": "added", "content": "  -H \"X-API-Key: $API_KEY\" \\"}, {"type": "added", "content": "  -d '{\"title\":\"Second Task\",\"status\":\"TODO\",\"priority\":\"MEDIUM\"}' > /dev/null"}, {"type": "added", "content": ""}, {"type": "added", "content": "DELETE_ALL_RESP=$(curl -s -w \"\\n%{http_code}\" -X DELETE \"$BASE_URL/api/v1/tasks\" -H \"X-API-Key: $API_KEY\")"}, {"type": "added", "content": "DELETE_ALL_CODE=$(echo \"$DELETE_ALL_RESP\" | tail -n1)"}, {"type": "added", "content": "DELETE_ALL_BODY=$(echo \"$DELETE_ALL_RESP\" | sed '$d')"}, {"type": "added", "content": "if [ \"$DELETE_ALL_CODE\" != \"200\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:delete all tasks expected 200, got $DELETE_ALL_CODE\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": "DELETED_COUNT=$(echo \"$DELETE_ALL_BODY\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('count',-1))\")"}, {"type": "added", "content": "if [ \"$DELETED_COUNT\" -lt 2 ]; then"}, {"type": "added", "content": "  echo \"FAILED:expected at least 2 tasks deleted, got $DELETED_COUNT\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 6. Verify list is now empty"}, {"type": "added", "content": "AFTER_LIST=$(curl -s \"$BASE_URL/api/v1/tasks?limit=20&offset=0\" -H \"X-API-Key: $API_KEY\")"}, {"type": "added", "content": "AFTER_TOTAL=$(echo \"$AFTER_LIST\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('total',-1))\")"}, {"type": "added", "content": "if [ \"$AFTER_TOTAL\" != \"0\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:expected 0 tasks remaining after delete-all, got $AFTER_TOTAL\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "# 7. GET the deleted task -> 404"}, {"type": "added", "content": "GET_404_CODE=$(curl -s -o /dev/null -w \"%{http_code}\" \"$BASE_URL/api/v1/tasks/$TASK_ID\" -H \"X-API-Key: $API_KEY\")"}, {"type": "added", "content": "if [ \"$GET_404_CODE\" != \"404\" ]; then"}, {"type": "added", "content": "  echo \"FAILED:expected 404 for deleted task, got $GET_404_CODE\""}, {"type": "added", "content": "  exit 1"}, {"type": "added", "content": "fi"}, {"type": "added", "content": ""}, {"type": "added", "content": "echo \"PASSED\""}, {"type": "added", "content": "exit 0"}]}]}]}